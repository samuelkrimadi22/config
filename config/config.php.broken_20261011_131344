/**
 * Set cookie dengan aman
 */
function setSecureCookie($name, $value, $expire = null) {
    $expire = $expire ?? (time() + COOKIE_EXPIRE);
    $isProduction = (APP_ENV === 'production');
    setcookie($name, $value, [
        'expires' => $expire,
        'path' => '/',
        'domain' => '',
        'secure' => $isProduction,
        'httponly' => true,
        'samesite' => 'Lax'
    ]);
    $_COOKIE[$name] = $value;
}

/**
 * Hapus cookie
 */
function deleteSecureCookie($name) {
    $isProduction = (APP_ENV === 'production');
    setcookie($name, '', [
        'expires' => time() - 3600,
        'path' => '/',
        'domain' => '',
        'secure' => $isProduction,
        'httponly' => true,
        'samesite' => 'Lax'
    ]);
    unset($_COOKIE[$name]);
}

/**
 * Ambil auth token dari cookie
 */
function getAuthToken() {
    return $_COOKIE[COOKIE_TOKEN] ?? null;
}

/**
 * Set auth token + user info ke cookie
 */
function setAuthToken($token, $user = null) {
    setSecureCookie(COOKIE_TOKEN, $token);

    if ($user) {
        if (!empty($user['username'])) {
            setSecureCookie(COOKIE_USERNAME, $user['username']);
        }
        if (!empty($user['plan'])) {
            setSecureCookie(COOKIE_PLAN, $user['plan']);
        }
        setSecureCookie(COOKIE_ADMIN, !empty($user['is_admin']) ? '1' : '0');
    }
}

/**
 * Hapus semua auth cookie
 */
function clearAuthToken() {
    deleteSecureCookie(COOKIE_TOKEN);
    deleteSecureCookie(COOKIE_USERNAME);
    deleteSecureCookie(COOKIE_PLAN);
    deleteSecureCookie(COOKIE_ADMIN);
}

