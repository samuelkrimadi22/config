function decodeJWT($token) {
    if (!$token) return null;
    
    $secret = getenv('JWT_SECRET');
    if (!$secret || strlen($secret) < 32) {
        error_log('[SECURITY] JWT_SECRET tidak valid atau tidak di-load');
