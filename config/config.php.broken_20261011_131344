/**
 * Format durasi (detik ke format readable)
 */
function formatDuration($seconds) {
    if ($seconds < 60) return round($seconds, 1) . 's';
    $mins = floor($seconds / 60);
    $secs = round($seconds % 60);
    return $mins . 'm ' . $secs . 's';
}

