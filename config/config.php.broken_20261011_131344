// V9.6.0 SECURITY: Verify JWT signature dengan firebase/php-jwt
require_once __DIR__ . '/../vendor/autoload.php';

use Firebase\JWT\JWT;
use Firebase\JWT\Key;
use Firebase\JWT\ExpiredException;
use Firebase\JWT\SignatureInvalidException;
use Firebase\JWT\BeforeValidException;

function decodeJWT($token) {
    if (!$token) return null;
    
    $secret = getenv('JWT_SECRET');
    if (!$secret || strlen($secret) < 32) {
        error_log('[SECURITY] JWT_SECRET tidak valid atau tidak di-load');
        return null;
    }
    
    try {
        // â­ Verify signature HMAC-SHA256 â€” mencegah tampering
        $payload = (array) JWT::decode($token, new Key($secret, 'HS256'));
        return $payload;
    } catch (ExpiredException $e) {
        return null;  // Token expired
    } catch (SignatureInvalidException $e) {
        error_log('[SECURITY] ðŸš¨ JWT signature INVALID â€” possible tampering! IP: ' . ($_SERVER['REMOTE_ADDR'] ?? 'unknown'));
        return null;
    } catch (BeforeValidException $e) {
        return null;
    } catch (Exception $e) {
        error_log('[SECURITY] JWT decode error: ' . $e->getMessage());
        return null;
    }
}

/**
 * Cek apakah token expired
 */
function isTokenExpired($token) {
    $payload = decodeJWT($token);
    if (!$payload || !isset($payload['exp'])) return true;
    return $payload['exp'] < time();
}

